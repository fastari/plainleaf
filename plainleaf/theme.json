{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "base", "name": "Background", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Surface (boxes, cards)", "color": "#F5F5F2" },
				{ "slug": "contrast", "name": "Text", "color": "#1C1C1C" },
				{ "slug": "muted", "name": "Muted text", "color": "#5C5C5C" },
				{ "slug": "line", "name": "Divider line", "color": "#E4E4E0" },
				{ "slug": "brand", "name": "Brand (hero band, badges)", "color": "#EFEFEA" },
				{ "slug": "brand-deep", "name": "Brand deep (large text, lines)", "color": "#6B6B66" },
				{ "slug": "brand-ink", "name": "Brand ink (small brand text)", "color": "#4A4A46" },
				{ "slug": "on-brand", "name": "Text on brand", "color": "#1C1C1C" },
				{ "slug": "accent", "name": "Accent (buttons)", "color": "#1C1C1C" },
				{ "slug": "accent-hover", "name": "Accent hover", "color": "#3A3A3A" },
				{ "slug": "on-accent", "name": "Text on accent", "color": "#FFFFFF" }
			]
		},
		"custom": {
			"radius": {
				"button": "0.75rem",
				"card": "1rem",
				"pill": "999px"
			},
			"line-height": {
				"tight": "1.15",
				"snug": "1.35",
				"body": "1.7"
			}
		},
		"layout": {
			"contentSize": "38rem",
			"wideSize": "72rem"
		},
		"shadow": {
			"defaultPresets": false
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "3XS", "size": "0.25rem" },
				{ "slug": "20", "name": "2XS", "size": "0.5rem" },
				{ "slug": "30", "name": "XS", "size": "1rem" },
				{ "slug": "40", "name": "S", "size": "clamp(1.25rem, 3vw, 1.75rem)" },
				{ "slug": "50", "name": "M", "size": "clamp(1.75rem, 5vw, 3rem)" },
				{ "slug": "60", "name": "L", "size": "clamp(2.5rem, 7vw, 4.5rem)" },
				{ "slug": "70", "name": "XL", "size": "clamp(3.5rem, 9vw, 6.5rem)" },
				{ "slug": "80", "name": "2XL", "size": "clamp(4.5rem, 12vw, 9rem)" }
			],
			"units": [ "px", "em", "rem", "%", "vh", "vw", "ch" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": false,
			"dropCap": false,
			"fontSizes": [
				{ "slug": "x-small", "name": "Extra small", "size": "0.875rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium (body)", "size": "1.125rem", "fluid": { "min": "1.0625rem", "max": "1.125rem" } },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.875rem", "fluid": { "min": "1.5rem", "max": "1.875rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
				{ "slug": "display", "name": "Display", "size": "3.75rem", "fluid": { "min": "2.375rem", "max": "3.75rem" } }
			],
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Newsreader (titles)",
					"fontFamily": "Newsreader, Georgia, Cambria, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader/Newsreader-Variable.woff2"
							]
						}
					]
				},
				{
					"slug": "sans",
					"name": "Work Sans (interface)",
					"fontFamily": "\"Work Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Work Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/work-sans/WorkSans-Variable.woff2"
							]
						}
					]
				},
				{
					"slug": "serif",
					"name": "Newsreader (reading)",
					"fontFamily": "Newsreader, Georgia, Cambria, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader/Newsreader-Variable.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader/Newsreader-Italic-Variable.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "System monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|serif",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large", "lineHeight": "var(--wp--custom--line-height--snug)" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|medium", "lineHeight": "var(--wp--custom--line-height--snug)" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "var(--wp--custom--line-height--snug)" } },
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase",
					"lineHeight": "var(--wp--custom--line-height--snug)"
				}
			},
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|on-accent"
				},
				"border": {
					"radius": "var(--wp--custom--radius--button)",
					"width": "0"
				},
				"spacing": {
					"padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.5rem", "right": "1.5rem" }
				},
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"lineHeight": "1.3",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-hover",
						"text": "var:preset|color|on-accent"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|accent-hover",
						"text": "var:preset|color|on-accent"
					},
					"outline": {
						"color": "var:preset|color|contrast",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small",
					"lineHeight": "1.45"
				}
			},
			"cite": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontStyle": "normal"
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "currentColor"
						},
						"border": {
							"color": "currentColor",
							"width": "1.5px",
							"style": "solid"
						},
						"spacing": {
							"padding": { "top": "calc(0.8rem - 1.5px)", "bottom": "calc(0.8rem - 1.5px)", "left": "calc(1.5rem - 1.5px)", "right": "calc(1.5rem - 1.5px)" }
						},
						"css": "& .wp-block-button__link:hover{background-color:color-mix(in srgb, currentColor 8%, transparent);}"
					}
				}
			},
			"core/buttons": {
				"spacing": { "blockGap": "0.75rem" }
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.6"
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|muted" },
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|muted" },
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "500"
				},
				"css": "& a { white-space: nowrap; }",
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/post-author-name": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "500"
				}
			},
			"core/post-time-to-read": {
				"color": { "text": "var:preset|color|muted" },
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "500"
				}
			},
			"core/post-navigation-link": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				}
			},
			"core/query-title": {
				"typography": { "fontSize": "var:preset|font-size|xx-large" }
			},
			"core/term-description": {
				"typography": { "fontSize": "var:preset|font-size|medium" },
				"color": { "text": "var:preset|color|muted" }
			},
			"core/separator": {
				"border": {
					"color": "var:preset|color|line",
					"style": "solid",
					"width": "0 0 1px 0"
				},
				"color": { "text": "var:preset|color|line" },
				"css": "&:not(.is-style-dots){opacity:1;}"
			},
			"core/quote": {
				"border": {
					"color": "var:preset|color|brand",
					"style": "solid",
					"width": "0 0 0 3px"
				},
				"spacing": {
					"padding": { "top": "0", "bottom": "0", "left": "var:preset|spacing|40", "right": "0" },
					"margin": { "left": "0", "right": "0" }
				},
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontStyle": "italic",
					"lineHeight": "1.5"
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var:preset|color|brand",
					"style": "solid",
					"width": "2px 0"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "600",
					"lineHeight": "1.25"
				},
				"spacing": {
					"padding": { "top": "var:preset|spacing|40", "bottom": "var:preset|spacing|40" }
				}
			},
			"core/code": {
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|contrast"
				},
				"border": { "radius": "0.5rem" },
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.6"
				},
				"spacing": {
					"padding": { "top": "var:preset|spacing|30", "bottom": "var:preset|spacing|30", "left": "var:preset|spacing|30", "right": "var:preset|spacing|30" }
				}
			},
			"core/preformatted": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/list": {
				"css": "& li + li { margin-top: 0.4em; }"
			},
			"core/image": {
				"border": { "radius": "0.5rem" }
			},
			"core/search": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|medium"
				},
				"css": "& .wp-block-search__input{border:1.5px solid var(--wp--preset--color--contrast);border-radius:var(--wp--custom--radius--button);background:var(--wp--preset--color--base);color:var(--wp--preset--color--contrast);padding:0.7rem 1rem;}",
				"elements": {
					"button": {
						"spacing": { "margin": { "left": "0.5rem" } }
					}
				}
			},
			"core/table": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/details": {
				"border": {
					"color": "var:preset|color|line",
					"style": "solid",
					"width": "1px 0"
				},
				"spacing": {
					"padding": { "top": "var:preset|spacing|30", "bottom": "var:preset|spacing|30" }
				},
				"css": "& summary{font-family:var(--wp--preset--font-family--sans);font-weight:600;cursor:pointer;}"
			},
			"core/comment-author-name": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				},
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/comment-date": {
				"color": { "text": "var:preset|color|muted" },
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small"
				},
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|muted" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/comment-content": {
				"typography": { "fontSize": "var:preset|font-size|medium" }
			},
			"core/comment-reply-link": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "500"
				}
			},
			"core/comment-edit-link": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small"
				}
			},
			"core/post-comments-form": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small"
				},
				"css": "& textarea, & input:not([type=submit]):not([type=checkbox]){border:1.5px solid var(--wp--preset--color--contrast);border-radius:0.5rem;background:var(--wp--preset--color--base);color:var(--wp--preset--color--contrast);padding:0.6rem 0.8rem;} & input[type=checkbox]{margin:0 .4rem 0 0;}"
			}
		}
	},
	"templateParts": [
		{ "area": "header", "name": "header", "title": "Header" },
		{ "area": "footer", "name": "footer", "title": "Footer" },
		{ "area": "uncategorized", "name": "newsletter-signup", "title": "Newsletter signup" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Full width, no title", "postTypes": [ "page" ] }
	]
}
